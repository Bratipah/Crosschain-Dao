# Never commit .env. Never put seed phrases, mnemonics, signing keys or VIA API
# credentials in this file in a public repository.
CARDANO_NETWORK=preprod
CARDANO_NODE_SOCKET_PATH=/path/to/cardano-node.socket
CARDANO_PAYMENT_SKEY=/secure/local/path/payment.skey
CARDANO_PREPROD_MAGIC=1
MIDNIGHT_NETWORK=preview
MIDNIGHT_PRIVATE_DAO_ADDRESS=replace-after-deployment
CARDANO_VOTING_ENDPOINT=replace-after-via-onboarding
CARDANO_EXECUTOR_ENDPOINT=replace-after-via-onboarding
MIDNIGHT_DAO_ENDPOINT=replace-after-via-onboarding
TEST_RECIPIENT=addr_test1...
CARDANO_TX_ID=replace-after-execution
